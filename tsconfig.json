{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@pages/*":      ["./src/pages/*"],
      "@components/*": ["./src/components/*"],
      "@helpers/*":    ["./src/helpers/*"],
      "@fixtures":     ["./src/fixtures/index.ts"],
      "@utils/*":      ["./src/utils/*"],
      "@config/*":     ["./src/config/*"]
    }
  }
}