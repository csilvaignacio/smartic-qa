# Copia este archivo como .env.<ambiente> (ej: .env.qa, .env.dev).
# El ambiente se elige con la variable AMBIENTE (por defecto: qa).
#   npm run test:qa   -> carga .env.qa
#   npm run test:dev  -> carga .env.dev

# ── URL base ─────────────────────────────
BASE_URL=https://tu-ambiente.smartic.cl

# ── Credenciales ─────────────────────────
QA_EMAIL=tu-email@empresa.cl
QA_PASSWORD=tu-password

# ── Datos de empresa ─────────────────────
QA_COMPANY=NombreEmpresa

# ── RUTs de colaboradores de prueba ──────
QA_RUT_PRUEBA1=12.345.678-9
